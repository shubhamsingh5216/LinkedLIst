class DoublyLinkedList{
    Node head;
        class Node{
            int data;
            Node next;
            Node prev;
        Node(int data){
            this.data = data;
            this.next = null;
            this.prev = null;
        }
    }
    public Node DeletekeyInDoublyLinkedList(int target){
        Node current = head;
        while(current != null){
            if(current.data == target){
                if(current == head){
                    head = head.next;
                    if(head != null){
                        head.prev = null;
                    }
                }
                else{
                    current.prev.next = current.next;
                }
                if(current.next != null){
                    current.next.prev = current.prev;
                }
            }
            current = current.next;
        }
        return head;
    }
}
